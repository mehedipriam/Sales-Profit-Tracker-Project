MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=sales_tracker
MYSQL_USER=tracker
MYSQL_PASSWORD=change-me
# at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-32chars-min

# Phase 6a: only used by docker-compose.prod.yml / nginx/init-letsencrypt.sh, not by plain `docker compose up`
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com

# Phase 8a: only used by scripts/backup-db.sh and scripts/restore-db.sh. Any S3-compatible bucket works -
# AWS S3, Backblaze B2, DigitalOcean Spaces, MinIO... - BACKUP_S3_ENDPOINT is what points it at yours.
BACKUP_S3_BUCKET=change-me-bucket-name
BACKUP_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
BACKUP_S3_ACCESS_KEY=change-me
BACKUP_S3_SECRET_KEY=change-me
