# TLS-terminating reverse proxy for production (Phase 6a): serves the built React app and proxies
# /api to the backend, same as frontend/nginx.conf, plus HTTPS and an HTTP -> HTTPS redirect.
# Rendered to nginx/prod.conf by nginx/init-letsencrypt.sh, which replaces __DOMAIN__ with the real
# domain from .env.

# Load balancing (Phase 6b): round-robin (nginx's default - no directive needed) across both backend
# containers. This is open-source nginx, so there is no active health polling of /actuator/health from
# here; the check is passive - max_fails failed proxy attempts within fail_timeout mark a backend down
# for that same window, so live traffic stops going to a dead instance without an operator doing
# anything. (Docker Compose's own healthcheck, already on the backend image and already used for
# `depends_on: condition: service_healthy`, is what decides whether a container is fit to receive
# traffic in the first place and restarts it if not - the two checks are complementary.)
upstream backend_pool {
    server backend:8080 max_fails=3 fail_timeout=10s;
    server backend2:8080 max_fails=3 fail_timeout=10s;
}

# Hardening (Phase 6c).
# Rate limiting: at most 1 request/second per client IP against the auth endpoints, with short bursts of
# up to 5 allowed outright (nodelay) rather than queued/delayed - generous enough that a real person
# fumbling a password a few times never notices, but it caps a scripted attacker at ~3600 attempts/hour
# per IP instead of however many the network allows. 10m of zone storage is ~160k tracked IPs.
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=1r/s;
limit_req_status 429;

# Access log: the default format plus which backend served the request and how long it took - directly
# useful for watching the Phase 6b load balancer in `docker compose logs -f frontend` (nginx's official
# image already symlinks both access.log and error.log to stdout/stderr, so no extra plumbing is needed
# to see them - see README: "Hardening"). A full log aggregation stack (Loki/Grafana or similar) is
# Phase 8, once there's actually a fleet of servers to justify it, not built speculatively here.
log_format main_ext '$remote_addr - $remote_user [$time_local] "$request" '
                     '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                     'upstream=$upstream_addr rt=${request_time}s';

server {
    listen 80;
    server_name __DOMAIN__;

    # Let's Encrypt validates domain ownership by fetching a token from here.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Everything else: force HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/access.log main_ext;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Login and registration specifically - the credential-guessing surface - are rate-limited; an exact
    # match takes priority over the general /api/ block below regardless of directive order.
    location = /api/auth/login {
        include /etc/nginx/security-headers.conf;
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://backend_pool;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/auth/register {
        include /etc/nginx/security-headers.conf;
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://backend_pool;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        include /etc/nginx/security-headers.conf;
        proxy_pass http://backend_pool;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Phase 8b: what an external uptime monitor (UptimeRobot, healthchecks.io, ...) should point at - one
    # URL that only returns 200 if nginx AND a real backend behind it are both actually up.
    location = /actuator/health {
        proxy_pass http://backend_pool/actuator/health;
        proxy_set_header Host $host;
    }

    # Vite fingerprints everything in /assets, so it can be cached forever.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Client-side routes (/orders, /reports ...) must fall back to index.html; never cache it so a deploy shows up.
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
